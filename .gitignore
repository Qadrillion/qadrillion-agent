# Nested working checkouts declared in workspace-manifest.json — each has its own git history.
/automation/
/source/

# Credentials — never committed. Templates end in .example and are allowed by the read hook.
.env
.env.*
!.env.example
.agent/mcp.json
.cursor/mcp.json
.claude/settings.local.json
*.pem
*.key
*.p12
*.keystore
*.jks
*credentials*
!*credentials*.example*

# Local runtime state; retain old ignored paths during migration.
.agent-temp/
/.agent-runtime-transaction/
/.agent-runtime-stage-*/
/.agent-runtime-complete-*/
.cursor-temp/
.cursor-cache/
.agent/plans/
.agent/settings.json
tools/claude/.sessions/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Test output
reports/
allure-results/
allure-report/
newman-results/
test-results/
playwright-report/

# Node
node_modules/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
